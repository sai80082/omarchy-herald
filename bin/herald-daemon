#!/usr/bin/env python3
"""herald-daemon — watch an IMAP mailbox and announce what actually matters.

Arriving mail is fetched, reduced to a short plain-text excerpt, and handed to
an OpenAI-compatible endpoint that returns a structured verdict: is this a
one-time code, a transaction, a security alert, a delivery, a calendar
invite, or nothing worth interrupting anyone for. Each verdict becomes an
Omarchy notification and a JSON line on stdout.

The JSON lines are the whole interface to the shell plugin. Nothing else is
printed to stdout, so the plugin can parse the stream without a framing
protocol, and `herald-daemon --once` in a terminal shows exactly what the
plugin would see.

Stdlib only, on purpose: this runs on a stock Omarchy box with no pip install
and nothing to keep up to date.
"""

from __future__ import annotations

import argparse
import email
import email.header
import email.utils
import hashlib
import imaplib
import json
import os
import re
import signal
import subprocess
import sys
import time
import urllib.error
import urllib.request
from html.parser import HTMLParser

HOME = os.path.expanduser("~")
CONFIG_PATH = os.path.join(HOME, ".config", "omarchy", "herald", "config.json")
STATE_DIR = os.path.join(HOME, ".local", "state", "omarchy", "herald")
EVENTS_PATH = os.path.join(STATE_DIR, "events.jsonl")
STATE_PATH = os.path.join(STATE_DIR, "state.json")

# History the panel can replay after a shell restart. Ten screens' worth is
# plenty for "what did I just miss" and keeps the file small enough to read
# and rewrite whole on every append.
EVENT_HISTORY_LIMIT = 200

# RFC 2177 puts the ceiling at 29 minutes; servers drop idle connections that
# sit past it without a fresh DONE/IDLE round trip.
IDLE_SECONDS = 29 * 60

CATEGORIES = ("otp", "transaction", "security", "delivery", "calendar", "other")

# Exit codes the shell plugin reads back. A watcher that stops for one of
# these is not coming back on a timer: retrying a missing password or a
# rejected login only produces log noise, and repeated rejections are how
# accounts get locked. Service.qml parks on these and waits for the config
# file to change or for someone to ask for a reconnect.
EXIT_UNCONFIGURED = 3
EXIT_AUTH = 4

# Consecutive login rejections tolerated before giving up. More than one
# because a server can refuse a login it will accept a moment later; not many
# more, because a provider counts them.
MAX_AUTH_FAILURES = 3


class FatalConfig(Exception):
    """The config cannot work as written. Retrying changes nothing."""


class AuthRejected(Exception):
    """The server refused these credentials."""

GLYPHS = {
    "otp": "\U000f0bc4",          # nf-md-shield_key
    "transaction": "\U000f019b",  # nf-md-credit_card
    "security": "\U000f0ecc",     # nf-md-shield_alert
    "delivery": "\U000f0788",     # nf-md-truck_fast
    "calendar": "\U000f00ed",     # nf-md-calendar
    "other": "\U000f01ee",        # nf-md-email
}

DEFAULTS = {
